{
	"name": "@endolphin/playwright-e2e",
	"version": "0.0.0",
	"private": true,
	"description": "endolphin fork-owned Playwright e2e rig (see docs/endolphin/playwright-e2e.md). Standalone workspace — does not depend on the root workspace.",
	"packageManager": "pnpm@11.5.2",
	"scripts": {
