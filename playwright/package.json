		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"devDependencies": {
		"@playwright/test": "1.61.0",
		"@types/node": "24.13.1",
		"typescript": "5.9.3"
	}
}
